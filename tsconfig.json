{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ES2020",
		"moduleResolution": "bundler",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"outDir": "dist/js",
		"rootDir": "web/ts",
		"sourceMap": true,
		"lib": ["ES2020", "DOM", "DOM.Iterable"]
	},
	"include": ["web/ts/**/*.ts"]
}
