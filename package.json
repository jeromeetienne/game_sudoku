{
	"name": "game-sudoku",
	"version": "1.0.0",
	"description": "A Sudoku game in static HTML + TypeScript, publishable on GitHub Pages",
	"private": true,
	"scripts": {
		"build": "bash scripts/build.sh",
		"watch": "tsc --watch",
		"serve": "npm run build && npx --yes http-server -c-1 -p 8080 ./dist",
		"deploy": "npm run build && gh-pages -d dist -t"
	},
	"devDependencies": {
		"gh-pages": "^6.1.0",
		"typescript": "^5.4.0"
	}
}
